# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=social_db
POSTGRES_USER=social_user
POSTGRES_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Keycloak
# Pattern: http(s)://<host>:<port>/realms/<realm-name>
KEYCLOAK_ISSUER_URI=

# OpenTelemetry
# Pattern: http(s)://<collector-host>:<port>
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sampling probability between 0.0 and 1.0 (default: 0.1)
OTEL_SAMPLING_PROBABILITY=