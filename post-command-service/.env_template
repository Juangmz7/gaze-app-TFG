# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=post_command_service_db
POSTGRES_USER=post_command_user
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Keycloak
# Pattern: http(s)://<host>:<port>/realms/<realm-name>
KEYCLOAK_ISSUER_URI=

# OpenTelemetry
# Pattern: http(s)://<collector-host>:<port>
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sampling probability between 0.0 and 1.0 (default: 0.1)
OTEL_SAMPLING_PROBABILITY=

# Azure Blob Storage (post media uploads)
# Pattern: https://<account>.blob.core.windows.net  (Azurite emulator: http://<host>:10000/<account>)
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
# ISO-8601 duration for the upload SAS TTL (default: PT15M)
AZURE_STORAGE_UPLOAD_SAS_TTL=PT15M
# Only used for local/Azurite account-key auth. Never set in cloud environments (DefaultAzureCredential is used instead).
AZURE_STORAGE_ACCOUNT_KEY=
